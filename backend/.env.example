## Backend environment (MySQL-only)
## Copy to backend/.env and edit values.

# Database (URL-encode special characters in password)
MICROGRID_DATABASE_URL=mysql+aiomysql://root:Virus1738%25@localhost:3306/smart_microgrid

# Logging
MICROGRID_LOG_LEVEL=INFO
MICROGRID_LOG_ACCESS=true
MICROGRID_LOG_COLOR=true

# Simulation / controller loop
# For live ESP32 sensors over MQTT: set USE_HARDWARE_SIMULATION=false and configure MQTT below.
MICROGRID_USE_HARDWARE_SIMULATION=true
MICROGRID_CONTROLLER_LOOP_ENABLED=true
MICROGRID_SIMULATOR_INTERVAL_SECONDS=60

# MQTT (only when MICROGRID_USE_HARDWARE_SIMULATION=false) — must match firmware secrets.h / MQTT_TOPIC_PREFIX
# MICROGRID_MQTT_HOST=192.168.1.10
# MICROGRID_MQTT_PORT=1883
# MICROGRID_MQTT_TOPIC_PREFIX=microgrid

# Weather (Open-Meteo)
MICROGRID_WEATHER_FORECAST_ENABLED=true
MICROGRID_WEATHER_LATITUDE=-17.8
MICROGRID_WEATHER_LONGITUDE=31.05
MICROGRID_WEATHER_PV_CAPACITY_KW=1.0
MICROGRID_WEATHER_PANEL_DERATE=0.85

