// Copy this file to secrets.h and fill in your network and broker.
#pragma once

// --- Wi‑Fi (2.4 GHz networks only on most ESP32; use your router SSID/password) ---
#define WIFI_SSID "your_wifi_ssid"
#define WIFI_PASSWORD "your_wifi_password"

// --- MQTT broker (must be reachable over Wi‑Fi from the ESP32) ---
// Use the LAN IP of the PC running Mosquitto, e.g. 192.168.1.10 — NOT "localhost" or 127.0.0.1
// (those refer to the ESP32 itself). Find the IP on the PC: `hostname -I` or your OS network settings.
#define MQTT_HOST "192.168.100.104"
#define MQTT_PORT 1883

// Must match backend MICROGRID_MQTT_TOPIC_PREFIX (default: microgrid).
#define MQTT_TOPIC_PREFIX "microgrid"

// Set to 0 if the digital light sensor is not wired (backend clears stale light in the UI).
// #define LIGHT_SENSOR_ENABLED 0
